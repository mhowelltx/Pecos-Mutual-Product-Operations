<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if type == "home" %}{{ site.name }}{% else %}{{ title }} · {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ summary }}">
  <link rel="icon" href="/assets/img/logos/pecos-mutual-mark.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/bundle.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  <script src="/assets/js/menu.js" defer></script>
</head>
<body class="pm-root site-type--{{ type }}">
  <a class="site-skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
